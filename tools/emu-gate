#!/usr/bin/env node
'use strict';
/**
 * The emulator release gate for what draws an app's picture (release.js
 * GATED: mgu-render, robertn_store). For each component named: a fresh
 * iDrive 7 emulator with the published release (mgu-emulator `up --preset
 * store`), this checkout's build of that component installed on its own, a
 * head-unit restart, then the Store opened through each case below; after
 * each the Store must be the app in front (mgu-render's foreground gate) with
 * its page drawn (not the HMI's empty page, not black) and, on a layer, its
 * layer listed and visible. All passing, it writes
 * release/gate/<id>.json for the component's exact source, which
 * `release.js publish` requires. Commit that file. The component is built
 * at the version the release would give it (a patch).
 * HEAD needs its <id>@<version> tags (git fetch --tags).
 *
 *   tools/emu-gate <id>...
 *
 * MGU_EMULATOR: the shared mgu-emulator checkout (default
 * ~/workspaces/personal/mgu-emulator), with no changes to its tracked files;
 * the record names its commit. The run is its own emulator instance
 * (mgu-emu-gate), destroyed after it (EMU_GATE_KEEP=1 keeps it; one component
 * then). One run at a time: a run removes what an interrupted one left.
 */
const fs = require('fs');
const os = require('os');
const path = require('path');
const cp = require('child_process');
const zlib = require('zlib');
const { components, sourceCommit, GATED } = require('../release/release.js');

const REPO = path.resolve(__dirname, '..');
const EMULATOR = process.env.MGU_EMULATOR || path.join(os.homedir(), 'workspaces/personal/mgu-emulator');
const VM = 'mgu-emu-gate';
const OURS = [0x4d520000, 0x4d5200ff];   // mgu-render's layer ids
const FOREIGN = 0x4d47fff0;              // the stand-in for another renderer's layer
const STORE_TILE = [384, 190];           // the Store, the first tile in the published release's APPS menu
const PICTURE_COLOURS = 120;             // sampled: the Store's page 190-690 colours, the HMI's empty page ~70, black 1

const sleep = (s) => cp.spawnSync('sleep', [String(s)]);
function run(cmd, args, opts = {}) {
    const r = cp.spawnSync(cmd, args, Object.assign({ encoding: 'utf8', maxBuffer: 64 << 20, timeout: 30 * 60000 }, opts));
    if (r.status !== 0 && !opts.allowFail) {
        throw new Error(`${cmd} ${args.join(' ')}: ${(r.stderr || r.stdout || '').trim().split('\n').slice(-3).join(' | ')}`);
    }
    return r.stdout || '';
}

/* ---- PNG (8-bit RGB or RGBA, not interlaced: emu.py shot's) ---- */
function decodePng(buf) {
    let pos = 8, w = 0, h = 0, type = 0;
    const idat = [];
    while (pos < buf.length) {
        const len = buf.readUInt32BE(pos), kind = buf.toString('ascii', pos + 4, pos + 8), data = buf.slice(pos + 8, pos + 8 + len);
        if (kind === 'IHDR') {
            w = data.readUInt32BE(0); h = data.readUInt32BE(4); type = data[9];
            if (data[8] !== 8 || (type !== 2 && type !== 6) || data[12] !== 0) throw new Error('screenshot: unexpected PNG format');
        } else if (kind === 'IDAT') idat.push(data);
        pos += 12 + len;
    }
    const bpp = type === 6 ? 4 : 3, stride = w * bpp, raw = zlib.inflateSync(Buffer.concat(idat));
    const px = Buffer.alloc(stride * h);
    for (let y = 0; y < h; y++) {
        const f = raw[y * (stride + 1)], src = y * (stride + 1) + 1, row = y * stride;
        for (let x = 0; x < stride; x++) {
            const a = x >= bpp ? px[row + x - bpp] : 0, b = y ? px[row - stride + x] : 0, c = x >= bpp && y ? px[row - stride + x - bpp] : 0;
            let v = raw[src + x];
            if (f === 1) v += a;
            else if (f === 2) v += b;
            else if (f === 3) v += (a + b) >> 1;
            else if (f === 4) { const p = a + b - c, pa = Math.abs(p - a), pb = Math.abs(p - b), pc = Math.abs(p - c); v += pa <= pb && pa <= pc ? a : pb <= pc ? b : c; }
            px[row + x] = v & 0xff;
        }
    }
    return { w, h, bpp, px };
}
/* distinct colours (4 bits a channel) in the page's content area */
function pictureColours(file) {
    const { w, h, bpp, px } = decodePng(fs.readFileSync(file));
    const seen = new Set();
    for (let y = Math.floor(h * 0.15); y < Math.floor(h * 0.95); y += 2) {
        for (let x = Math.floor(w * 0.07); x < Math.floor(w * 0.97); x += 2) {
            const i = (y * w + x) * bpp;
            seen.add(((px[i] >> 4) << 8) | ((px[i + 1] >> 4) << 4) | (px[i + 2] >> 4));
        }
    }
    return seen.size;
}

/* ---- the emulator ---- */
function emulator(dir) {
    const emu = (...args) => run('./emu.py', args, { cwd: dir, env: Object.assign({}, process.env, { EMU_LIMA: VM }) });
    const emuMay = (...args) => run('./emu.py', args, { cwd: dir, env: Object.assign({}, process.env, { EMU_LIMA: VM }), allowFail: true });
    let port = 0, identity = '';
    const sshArgs = () => ['-p', String(port), '-i', identity, '-o', 'StrictHostKeyChecking=no',
        '-o', 'UserKnownHostsFile=/dev/null', '-o', 'LogLevel=ERROR', '-o', 'IdentitiesOnly=yes', '-o', 'ConnectTimeout=10'];
    const self = {
        up() {
            const out = emu('up', '--preset', 'store');
            const m = out.match(/--port (\d+) --identity (\S+)/);
            if (!m) throw new Error('emulator: no SSH port and key in the output of up');
            port = Number(m[1]);
            identity = m[2];
        },
        sh(cmd, allowFail) { return run('ssh', sshArgs().concat(['root@127.0.0.1', cmd]), { allowFail, timeout: 10 * 60000 }); },
        put(file, to) { run('scp', ['-q', '-P', String(port)].concat(sshArgs().slice(2), [file, `root@127.0.0.1:${to}`])); },
        restart() {
            emu('restart');
            self.waitReady();
        },
        waitReady() {
            for (let i = 0; i < 120; i++) {
                if (cp.spawnSync('ssh', sshArgs().concat(['root@127.0.0.1', 'systemctl is-active -q oapcontroller.service && [ -S /run/wayland/wayland-0 ]'])).status === 0) return;
                sleep(5);
            }
            throw new Error('emulator: the head unit did not come up');
        },
        button(n) { emu('button', String(n)); },
        touch(x, y) { emu('touch', String(x), String(y)); },
        colours() {
            const f = path.join(os.tmpdir(), `emu-gate-${process.pid}.png`);
            emu('shot', f);
            try { return pictureColours(f); } finally { fs.rmSync(f, { force: true }); }
        },
        /* the uid mgu-render's foreground gate last named in front */
        front() {
            const m = self.sh('journalctl -u mgu-render --no-pager -n 300 | grep "in front:" | tail -n 1', true).match(/in front: (\d+)/);
            return m ? Number(m[1]) : 0;
        },
        storeUid() {
            const s = JSON.parse(self.sh('sh /var/opt/mgu-deploy/mgu-deploy.sh status --json'));
            const app = s.components.find((x) => x.id === 'robertn_store');
            return app ? app.uid : 0;
        },
        /* the centre screen's layer list, and each layer's visibility */
        scene() {
            const out = self.sh('XDG_RUNTIME_DIR=/run/wayland ivi-control scene');
            const screen = out.match(/^screen (\d+)\n(?:\t.*\n)*?\tlayers:([^\n]*)/m);
            const vis = {};
            let layer = null;
            out.split('\n').forEach((l) => {
                const m = l.match(/^layer (\d+)/);
                if (m) layer = Number(m[1]);
                else if (/^(surface|screen) /.test(l)) layer = null;
                else if (layer !== null && /^\tvisibility:/.test(l)) vis[layer] = /1\s*$/.test(l);
            });
            return { id: screen ? Number(screen[1]) : 0, list: screen ? screen[2].trim().split(/\s+/).filter(Boolean).map(Number) : [], vis };
        },
        down() { emuMay('down'); },
        destroy() { emuMay('destroy'); }
    };
    return self;
}

function oursShown(s) { return s.list.some((id) => id >= OURS[0] && id <= OURS[1] && s.vis[id]); }
function layers(s) { return s.list.map((id) => `0x${id.toString(16)}`).join(' '); }

/* waits up to secs for check(); its last answer */
function within(secs, check) {
    let r;
    for (let t = 0; t <= secs; t += 1) {
        r = check();
        if (r.ok) return r;
        sleep(1);
    }
    return r;
}

/* ---- the cases ---- */
function cases(hu, layerMode) {
    const uid = hu.storeUid();
    const picture = () => {
        const s = layerMode ? hu.scene() : null, colours = hu.colours(), front = hu.front() === uid;
        const ok = front && colours >= PICTURE_COLOURS && (!layerMode || oursShown(s));
        return { ok, detail: `${front ? 'in front' : 'NOT in front'}, ${colours} colours` + (s ? `, layers ${layers(s)}` : '') };
    };
    const openStore = () => {
        let r;
        for (let i = 0; i < 6; i++) {
            hu.button(8);
            sleep(4);
            hu.touch(...STORE_TILE);
            r = within(12, picture);
            if (r.ok) return r;
        }
        return r;
    };
    return { picture, openStore };
}

function gate(id, version, artifact, client, emuDir) {
    const results = [];
    const step = (name, r) => {
        results.push({ name, ok: !!r.ok, detail: r.detail });
        console.log(`${r.ok ? 'ok  ' : 'FAIL'} ${name}: ${r.detail}`);
        return r.ok;
    };
    const hu = emulator(emuDir);
    console.log('emulator: the published release (up --preset store)');
    hu.up();
    hu.sh('mkdir -p /var/opt/emu-gate');
    hu.put(artifact, `/var/opt/emu-gate/${path.basename(artifact)}`);
    hu.put(client, '/var/opt/emu-gate/ivi_client');
    const inst = hu.sh(`sh /var/opt/mgu-deploy/mgu-deploy.sh install --artifact /var/opt/emu-gate/${path.basename(artifact)} --yes 2>&1`, true);
    const now = JSON.parse(hu.sh('sh /var/opt/mgu-deploy/mgu-deploy.sh status --json')).components.find((x) => x.id === id);
    step('installed on its own over the published release', {
        // the same version as the published one installs nothing: there is nothing new to test
        ok: !/nothing to change/.test(inst) && now && now.version === version,
        detail: /nothing to change/.test(inst) ? `${version} is the published version: nothing new to test` : inst.trim().split('\n').pop()
    });
    hu.restart();

    let c = cases(hu, false);
    step('after the head-unit restart, the Store in its page (embed)', c.openStore());

    // layer mode: the Store on mgu-render's own ivi layer, as on iDrive 8 and for every community app
    hu.sh('f=$(readlink -f /var/opt/mgu-render/current)/mgu-render.conf && sed -i "s/^embed = 1/embed = 0/" "$f" && systemctl restart mgu-render.service');
    c = cases(hu, true);
    step('renderer restarted, the Store on its own layer', c.openStore());

    hu.sh(`XDG_RUNTIME_DIR=/run/wayland ivi-control screen ${hu.scene().id} renderorder 100`);
    step('another program sets the screen\'s layers without ours while shown', within(5, c.picture));

    // a client connected while our layer is off the list: its add_layer drops ours (Winston applies the caller's copy)
    hu.button(8);
    sleep(3);
    hu.sh(`XDG_RUNTIME_DIR=/run/wayland ivi-control screen ${hu.scene().id} renderorder 100`);
    hu.sh('cd /var/opt/emu-gate && rm -f in out && mkfifo in && (sleep 100000 > in & echo $! > sleep.pid) && ' +
        '(XDG_RUNTIME_DIR=/run/wayland WAYLAND_DISPLAY=wayland-0 ./ivi_client < in > out 2>&1 & echo $! > client.pid); ' +
        'i=0; while ! grep -q ready out && [ $i -lt 50 ]; do sleep 0.2; i=$((i+1)); done');
    step('the Store opened again', c.openStore());
    hu.sh(`cd /var/opt/emu-gate && printf 'layer ${FOREIGN}\\nadd ${FOREIGN}\\ncommit\\nsync\\n' > in`);
    step('a client open since before adds its layer while shown; ours back, its layer kept', within(5, () => {
        const r = c.picture(), s = hu.scene();
        return { ok: r.ok && s.list.includes(FOREIGN), detail: r.detail };
    }));
    hu.sh('cd /var/opt/emu-gate && kill $(cat client.pid sleep.pid) 2>/dev/null; true', true);

    hu.sh('systemctl restart mgu-render.service');
    step('renderer restarted while the Store shows', within(30, c.picture));
    return { results, hu };
}

function main(ids) {
    if (!ids.length || ids.some((id) => !GATED.includes(id)) || (process.env.EMU_GATE_KEEP && ids.length > 1)) {
        console.error(`usage: tools/emu-gate <id>...  (gated: ${GATED.join(', ')}; with EMU_GATE_KEEP one)`);
        return 2;
    }
    if (run('git', ['status', '--porcelain', '--untracked-files=no'], { cwd: REPO }).trim()) {
        console.error('emu-gate: commit first: the gate tests the build of HEAD');
        return 1;
    }
    const head = run('git', ['rev-parse', 'HEAD'], { cwd: REPO }).trim();
    const all = components();
    const started = Date.now();
    const tmp = path.join(os.tmpdir(), 'emu-gate');
    const emuChanged = () => run('git', ['-C', EMULATOR, 'status', '--porcelain', '--untracked-files=no']).trim();
    if (emuChanged()) {
        console.error(`emu-gate: ${EMULATOR} has changes; the gate runs a commit of the emulator`);
        return 1;
    }
    const clean = () => {
        // the instance's VM, its GPU server and its files
        emulator(EMULATOR).destroy();
        run('limactl', ['delete', '-f', VM], { allowFail: true });
        fs.rmSync(tmp, { recursive: true, force: true });
        run('git', ['worktree', 'prune'], { cwd: REPO, allowFail: true });
        run('git', ['-C', EMULATOR, 'worktree', 'prune'], { allowFail: true });
    };
    clean();
    fs.mkdirSync(tmp);
    if (process.env.EMU_GATE_KEEP) console.log(`kept after the run: the emulator instance ${VM} (EMU_LIMA=${VM})`);
    let failed = 0;
    try {
        // the stale-copy client: mgu-render's test client, built for the head unit
        const mr = path.join(REPO, 'native/mgu-render');
        console.log('building the test client for the head unit');
        run('docker', ['build', '-q', '--platform', 'linux/amd64', '-t', 'mgu-render-target', 'docker/target'], { cwd: mr });
        run('docker', ['run', '--rm', '--platform', 'linux/amd64', '-v', `${mr}:/w:ro`, '-v', `${tmp}:/o`, '-w', '/w', 'mgu-render-target', 'sh', '-c',
            'for x in ivi-controller; do wayland-scanner client-header protocol/$x.xml /o/$x-client-protocol.h; ' +
            'wayland-scanner private-code protocol/$x.xml /o/$x-protocol.c; done && ' +
            'gcc -O2 -std=gnu11 -Isrc -I/o -Wl,--dynamic-linker=/lib/ld-linux-x86-64.so.2 -o /o/ivi_client test/ivi_client.c src/relist.c src/log.c /o/ivi-controller-protocol.c -lwayland-client']);
        const emuCommit = run('git', ['-C', EMULATOR, 'rev-parse', 'HEAD']).trim();
        for (const id of ids) {
            const c = all.find((x) => x.id === id);
            const source = sourceCommit(c);
            // tested at the version the release gives it, stamped into a scratch checkout of HEAD
            const built = stampedCheckout(id, tmp);
            const version = components(built).find((x) => x.id === id).version;
            console.log(`\n== ${id}@${version}`);
            run('node', ['release/release.js', 'build', id], { cwd: built, stdio: ['ignore', 'inherit', 'inherit'] });
            const entry = readCatalog(built).find((e) => e.id === id);
            const artifact = path.join(built, 'release/out', entry.artifact.name);
            const t0 = Date.now();
            let out;
            try {
                out = gate(id, version, artifact, path.join(tmp, 'ivi_client'), EMULATOR);
            } catch (e) {
                console.log(`FAIL ${id}: ${e.message}`);
                failed++;
                continue;
            } finally {
                if (!process.env.EMU_GATE_KEEP) emulator(EMULATOR).down();
            }
            if (!out.results.every((r) => r.ok)) { failed++; continue; }
            if (run('git', ['rev-parse', 'HEAD'], { cwd: REPO }).trim() !== head) {
                console.log(`FAIL ${id}: HEAD moved during the run; run the gate again`);
                failed++;
                continue;
            }
            // the shared emulator checkout ran the whole case at the commit the record names
            if (run('git', ['-C', EMULATOR, 'rev-parse', 'HEAD']).trim() !== emuCommit || emuChanged()) {
                console.log(`FAIL ${id}: ${EMULATOR} changed during the run; run the gate again`);
                failed++;
                continue;
            }
            const record = {
                id, version, source, result: 'pass',
                unit: 'id7', emulator: emuCommit, artifactSha256: entry.artifact.sha256,
                minutes: Math.round((Date.now() - t0) / 6000) / 10, cases: out.results
            };
            fs.mkdirSync(path.join(REPO, 'release/gate'), { recursive: true });
            fs.writeFileSync(path.join(REPO, 'release/gate', `${id}.json`), JSON.stringify(record, null, 2) + '\n');
            console.log(`pass: release/gate/${id}.json written (commit it)`);
        }
    } finally {
        if (!process.env.EMU_GATE_KEEP) clean();
    }
    console.log(`\nemu-gate: ${failed ? `${failed} failed` : 'all passed'} in ${Math.round((Date.now() - started) / 60000)} min`);
    return failed ? 1 : 0;
}

function readCatalog(root) {
    return JSON.parse(fs.readFileSync(path.join(root, 'release/out/catalog.json'), 'utf8')).components;
}

/* A scratch checkout of HEAD with the release commit `release.js stamp <id>`
 * makes (labels unread: a patch), removed with the run's folder. */
function stampedCheckout(id, tmp) {
    const dir = path.join(tmp, `stamped-${id}`);
    run('git', ['worktree', 'add', '-q', '--detach', dir, 'HEAD'], { cwd: REPO });
    run('node', ['release/release.js', 'stamp', id], { cwd: dir, env: Object.assign({}, process.env, { MGU_RELEASE_LABELS: 'off' }),
        stdio: ['ignore', 'inherit', 'inherit'] });
    return dir;
}

if (require.main === module) {
    try {
        process.exitCode = main(process.argv.slice(2));
    } catch (e) {
        console.error(`emu-gate: ${e.message}`);
        process.exitCode = 1;
    }
}

