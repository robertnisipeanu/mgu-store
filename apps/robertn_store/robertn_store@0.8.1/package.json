{
  "name": "robertn_store",
  "version": "0.8.1",
  "description": "The apps and head-unit tools of every source with their state, and the sources; installs, updates and removes them through mgu-updater",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 30,
    "memoryThresholdKB": 131072,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "STOR",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "owner",
  "license": "UNLICENSED",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID7",
    "ID8"
  ]
}
