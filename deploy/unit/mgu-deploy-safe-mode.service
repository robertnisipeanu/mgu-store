[Unit]
Description=mgu-deploy safe mode: our tools' units stay off after repeated failed starts of the head unit
# First at each start, once /var/opt is mounted: our tools' units start after it (their drop-in
# zz-mgu-deploy-limits.conf).
DefaultDependencies=no
RequiresMountsFor=/var/opt
# stopped (ExecStop) at every systemd shutdown, as DefaultDependencies=yes would
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
# This start counts as failed until it shows otherwise; after repeated failed starts, safe mode is on
# before our tools' units start.
ExecStartPre=-/bin/sh /var/opt/mgu-deploy/current/safe_mode.sh start
# recmgr's crash statistics as they stand at the start, for the shutdown's count (safe_mode.sh). A start
# that stays up 5 minutes clears the count. The service stays up after, so recmgr never sees it end.
ExecStart=-/bin/sh -c '/bin/sh /var/opt/mgu-deploy/current/safe_mode.sh stats; /bin/sh /var/opt/mgu-deploy/current/safe_mode.sh up; exec sleep 2147483647'
# An orderly stop of the system (systemctl reboot or poweroff) counts as a shutdown without a restart record.
ExecStop=-/bin/sh /var/opt/mgu-deploy/current/safe_mode.sh stop
TimeoutStartSec=10
TimeoutStopSec=10
StandardOutput=journal

[Install]
WantedBy=multi-user.target
