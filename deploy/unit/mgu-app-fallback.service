[Unit]
Description=mgu-deploy provisioning fallback for our apps
Before=oapcontroller.service app-privacy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'C=/var/opt/mgu-deploy/main.js; N=/run/mgu-deploy/main.fallback-boot.js; mkdir -p /run/mgu-deploy; B=/usr/lib/oap-mainapp/src/main.bundle.js; [ -f "$B" ] || B=/usr/lib/oap-mainapp/src/main.js; /usr/bin/node /var/opt/mgu-deploy/current/fallback_build.js "$B" "$N" /var/opt/public/oap/oap_12201/data/custom_apps.json || exit 0; if [ -f /var/opt/app-privacy/current/patch_mainapp.js ]; then /usr/bin/node /var/opt/app-privacy/current/patch_mainapp.js apply --main "$N" --json >/dev/null || exit 0; fi; /usr/bin/node --check "$N" || exit 0; /usr/bin/node -e "var f=require(process.argv[3]),a=process.argv[1],b=process.argv[2],n=f.readFileSync(a),o=null;try{o=f.readFileSync(b)}catch(e){}if(!o||!n.equals(o)){f.writeFileSync(b+process.argv[4],n);f.renameSync(b+process.argv[4],b)}" "$N" "$C" fs .tmp || exit 0; rm -f "$N"; mount --bind "$C" "$B"'
ExecStop=/bin/sh -c 'umount /usr/lib/oap-mainapp/src/main.bundle.js 2>/dev/null || umount /usr/lib/oap-mainapp/src/main.js || true'

[Install]
WantedBy=multi-user.target
