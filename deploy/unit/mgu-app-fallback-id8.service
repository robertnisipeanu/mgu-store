[Unit]
Description=mgu-deploy provisioning fallback and in-place installs for our apps (iDrive 8)
RequiresMountsFor=/var/opt
After=mgu-deploy-apply.service
Before=oapcontroller.service app-privacy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/bin/sh /var/opt/mgu-deploy/mgu-deploy.sh relist
ExecStart=/bin/sh -c '/usr/bin/node /var/opt/mgu-deploy/current/fallback_build.js /usr/lib/oap-mainapp21/src/main.js /var/opt/mgu-deploy/main.js /var/opt/public/oap/oap_12201/data/custom_apps.json || exit 0; if [ -f /var/opt/app-privacy/current/patch_mainapp.js ]; then /usr/bin/node /var/opt/app-privacy/current/patch_mainapp.js apply --main /var/opt/mgu-deploy/main.js --json >/dev/null || exit 0; fi; /usr/bin/node --check /var/opt/mgu-deploy/main.js || exit 0; mount --bind /var/opt/mgu-deploy/main.js /usr/lib/oap-mainapp21/src/main.js'
ExecStop=/bin/sh -c 'umount /usr/lib/oap-mainapp21/src/main.js || true'

[Install]
WantedBy=multi-user.target
