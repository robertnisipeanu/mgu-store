[Unit]
Description=mgu-deploy provisioning fallback and in-place installs for our apps (iDrive 8)
RequiresMountsFor=/var/opt
After=mgu-deploy-apply.service
Before=oapcontroller.service app-privacy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/bin/sh /var/opt/mgu-deploy/mgu-deploy.sh relist
ExecStart=/bin/sh -c 'C=/var/opt/mgu-deploy/main.js; N=/run/mgu-deploy/main.fallback-boot.js; mkdir -p /run/mgu-deploy; /usr/bin/node /var/opt/mgu-deploy/current/fallback_build.js /usr/lib/oap-mainapp21/src/main.js "$N" /var/opt/public/oap/oap_12201/data/custom_apps.json || exit 0; if [ -f /var/opt/app-privacy/current/patch_mainapp.js ]; then /usr/bin/node /var/opt/app-privacy/current/patch_mainapp.js apply --main "$N" --json >/dev/null || exit 0; fi; /usr/bin/node --check "$N" || exit 0; /usr/bin/node -e "var f=require(process.argv[3]),a=process.argv[1],b=process.argv[2],n=f.readFileSync(a),o=null;try{o=f.readFileSync(b)}catch(e){}if(!o||!n.equals(o)){f.writeFileSync(b+process.argv[4],n);f.renameSync(b+process.argv[4],b)}" "$N" "$C" fs .tmp || exit 0; rm -f "$N"; mount --bind "$C" /usr/lib/oap-mainapp21/src/main.js'
ExecStop=/bin/sh -c 'umount /usr/lib/oap-mainapp21/src/main.js || true'

[Install]
WantedBy=multi-user.target
