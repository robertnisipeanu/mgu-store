{
  "id": "app-privacy",
  "kind": "tool",
  "version": "1.7.1",
  "title": "App privacy",
  "description": "Keeps our apps out of the head unit's backend app reporting and restarts them after a crash",
  "versionFiles": ["patch_mainapp.js"],
  "mguHmi": ["ID7", "ID8"],
  "requires": { "mgu-deploy": "0.6.3" },
  "files": [
    { "path": "patch_mainapp.js", "from": "patch_mainapp.js", "mode": "0755" }
  ],
  "units": [
    { "name": "app-privacy.service", "from": "systemd/app-privacy.service" }
  ],
  "enable": [{ "unit": "app-privacy.service", "target": "multi-user.target" }],
  "recmgr": ["app-privacy"],
  "restart": []
}
