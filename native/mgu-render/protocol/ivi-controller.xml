<?xml version="1.0" encoding="UTF-8"?>
<!--
  ivi_controller v1, as built into the head unit's libivi-controller.so.1.11.0
  (wayland-ivi-extension 1.11.0) and implemented by the compositor's genivi.so
  plugin. Request/event names, opcodes (document order), signatures and
  argument interfaces match the descriptors in that library exactly; check
  with tools/check_protocol_abi.py. Argument names follow upstream COVESA
  wayland-ivi-extension 1.x.

  The interfaces are those of COVESA wayland-ivi-extension (DENSO CORPORATION,
  BMW Car IT GmbH).
-->
<protocol name="ivi_controller">
  <copyright>
    Copyright (C) 2013 DENSO CORPORATION
    Copyright (c) 2013 BMW Car IT GmbH

    Permission is hereby granted, free of charge, to any person obtaining a copy
